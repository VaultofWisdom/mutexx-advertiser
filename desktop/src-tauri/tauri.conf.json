{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Mutexx Advertiser",
  "version": "0.6.0",
  "identifier": "de.mutexxproduction.advertiser",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "create": false,
        "url": "index.html",
        "title": "Mutexx Advertiser",
        "width": 1380,
        "height": 900,
        "minWidth": 900,
        "minHeight": 620,
        "resizable": true,
        "center": true,
        "theme": "Dark",
        "backgroundColor": "#0a0a0f"
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'; img-src 'self' data:"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDgxNDRGQjNCOTlEODE5ODkKUldTSkdkaVpPL3RFZ1ordHdUTTNHa3BYMHZxOG92bUVKOWVCUUI5dExxVFd0NnAzQXArN2dCdFUK",
      "endpoints": [
        "https://github.com/VaultofWisdom/mutexx-advertiser/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": true,
    "resources": {
      "resources/python/": "python/",
      "resources/app/": "app/"
    },
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"],
    "windows": {
      "nsis": {
        "installMode": "perMachine",
        "startMenuFolder": "Mutexx Production",
        "template": "windows/installer.nsi",
        "installerHooks": "windows/installer-hooks.nsh",
        "languages": ["English", "German"],
        "displayLanguageSelector": true
      }
    },
    "publisher": "Mutexx Production",
    "copyright": "Mutexx Production",
    "shortDescription": "Marketing strategy and campaign preparation",
    "longDescription": "Mutexx Advertiser - analyses your product, picks the channels that suit it, finds communities whose rules allow it and prepares every post. It publishes nothing in other people's communities: the last click stays yours."
  }
}
